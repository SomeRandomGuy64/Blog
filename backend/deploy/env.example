# /etc/fazond/env (root:fazond, mode 0640)
FAZOND_LISTEN=127.0.0.1:8091
FAZOND_DATA=/var/lib/fazond
# Public site: magic links point here, and comment pages + titles come from $FAZOND_SITE/comment-pages.json.
FAZOND_SITE=https://fazon.nexus
# Production: the site only. Local dev adds http://localhost:1313,http://127.0.0.1:* (README).
FAZOND_ORIGINS=https://fazon.nexus
FAZOND_COOKIE_SECURE=true
FAZOND_ADMIN_EMAIL=m.faizan.rasul@gmail.com
FAZOND_ADMIN_NAME=Faizan

# Email: resend (production), smtp, or log (dev: magic links go to the journal).
FAZOND_MAIL=resend
# Resend API key (sending access only) in its own file: root:fazond, mode 0640.
FAZOND_RESEND_KEY_FILE=/etc/fazond/resend_key
# Defaults to "Fazon Nexus <login@fazon.nexus>" for resend; the domain must be verified in Resend.
# FAZOND_MAIL_FROM=Fazon Nexus <login@fazon.nexus>

# Alternative: SMTP with STARTTLS on 587 (Hetzner blocks outbound 25 and 465), e.g. Gmail + app password.
# FAZOND_MAIL=smtp
# FAZOND_SMTP_HOST=smtp.gmail.com
# FAZOND_SMTP_PORT=587
# FAZOND_SMTP_USER=m.faizan.rasul@gmail.com
# FAZOND_SMTP_PASS_FILE=/etc/fazond/smtp_pass
# FAZOND_MAIL_FROM=Fazon Nexus <m.faizan.rasul@gmail.com>

# Optional: mirror the admin's Track into the MvJ dojo tracker (README: MvJ sync). Off unless FAZOND_MVJ_EMAIL is set.
# FAZOND_MVJ_EMAIL=m.faizan.rasul@gmail.com
# Password in its own file: root:fazond, mode 0640.
# FAZOND_MVJ_PASSWORD_FILE=/etc/fazond/mvj_password
# The tracker's Supabase project and public anon key (from any of its requests in DevTools).
# FAZOND_MVJ_SUPABASE=https://<project>.supabase.co
# FAZOND_MVJ_ANON_KEY=<the apikey header>
# Earliest week mirrored (a Saturday). Weeks before it on the MvJ site are never touched.
# FAZOND_MVJ_FROM=2026-10-10
