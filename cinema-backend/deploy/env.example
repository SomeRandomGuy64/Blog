# /etc/cinemad/env (root:cinemad, mode 0640)
CINEMAD_LISTEN=127.0.0.1:8090
CINEMAD_DATA=/var/lib/cinemad
# openssl rand -hex 32 — the same value goes in the relay's ~/.config/cinema-relay/token
CINEMAD_INGEST_TOKEN=change-me
CINEMAD_ORIGINS=https://fazon.nexus,http://localhost:1313,http://127.0.0.1:*
# CINEMAD_INTERVAL=2h
# CINEMAD_WORKERS=8
# CINEMAD_CINEMA_TIMEOUT=5m
# CINEMAD_DAYS=16
# CINEMAD_MAX_BODY=16777216
