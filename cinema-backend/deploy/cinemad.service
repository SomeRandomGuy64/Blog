[Unit]
Description=Cinema listings API (cinemad)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cinemad
Group=cinemad
EnvironmentFile=/etc/cinemad/env
ExecStart=/usr/local/bin/cinemad
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# /var/lib/cinemad, created and owned by the cinemad user
StateDirectory=cinemad
StateDirectoryMode=0750
UMask=0027

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cinemad
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=512M

[Install]
WantedBy=multi-user.target
